# Copie este arquivo para .env na raiz do projeto e preencha localmente.
# Nunca publique o arquivo .env.

# MySQL compartilhado pelos microsservicos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=SEU_USUARIO_MYSQL
DB_PASSWORD=SUA_SENHA_MYSQL
DB_NAME=fraga_db

# Gere dois segredos fortes e diferentes para uso local.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_NO_MINIMO_32_CARACTERES
INTERNAL_SERVICE_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_FORTE

# Gateway
PORT=3000

# Portas dos servicos que aceitam configuracao por ambiente
AUTH_PORT=4001
CATALOGO_PORT=4002
PEDIDOS_PORT=4003
