# Copie este arquivo para .env na raiz e preencha localmente.
# Nunca publique o arquivo .env.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=SEU_USUARIO_MYSQL
DB_PASSWORD=SUA_SENHA_MYSQL

# Banco legado. Mantido como fallback durante a migração gradual.
DB_NAME=fraga_db

# Bancos individuais: manter fraga_db até concluir a remoção das consultas
# cruzadas e copiar/validar os dados de cada domínio.
DB_NAME_AUTH=fraga_db
DB_NAME_CATALOGO=fraga_db
DB_NAME_PEDIDOS=fraga_db
DB_NAME_ENTREGAS=fraga_db
DB_NAME_COZINHA=fraga_db
DB_NAME_NOTIFICACOES=fraga_db
DB_NAME_AVALIACOES=fraga_db
DB_NAME_ADMINISTRACAO=fraga_db
DB_NAME_ATENDIMENTO=fraga_db
DB_NAME_CLIENTES=fraga_db

JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_NO_MINIMO_32_CARACTERES
INTERNAL_SERVICE_SECRET=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_FORTE

PORT=3000
AUTH_PORT=4001
CATALOGO_PORT=4002
PEDIDOS_PORT=4003
